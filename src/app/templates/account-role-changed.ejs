<table width="100%" cellpadding="0" cellspacing="0" style="background:#f4f5f3;padding:32px 12px;font-family:Helvetica,Arial,sans-serif;">
  <tr>
    <td align="center">
      <table width="100%" cellpadding="0" cellspacing="0" style="max-width:520px;background:#ffffff;border:1px solid #d8dcd2;">
        <tr>
          <td style="padding:24px 28px;border-bottom:3px solid #1a1d1a;">
            <div style="font-size:18px;font-weight:bold;color:#1a1d1a;">DMS Distributor</div>
            <div style="font-size:11px;letter-spacing:1.4px;text-transform:uppercase;color:#7b8177;margin-top:4px;">Your access changed</div>
          </td>
        </tr>
        <tr>
          <td style="padding:28px;">
            <p style="margin:0 0 14px;font-size:15px;color:#1a1d1a;">Hello <%= name %>,</p>
            <p style="margin:0 0 20px;font-size:14px;line-height:1.55;color:#474d46;">
              <strong><%= actorName %></strong> changed your role in the system. What you can see and do has changed with it.
            </p>

            <table cellpadding="0" cellspacing="0" style="margin:0 0 20px;">
              <tr>
                <td style="border:1px solid #c7ccbe;background:#f4f5f3;padding:9px 16px;font-family:'Courier New',monospace;font-size:12px;color:#7b8177;"><%= previousRole %></td>
                <td style="padding:0 12px;font-size:16px;color:#7b8177;">&rarr;</td>
                <td style="border:1px solid #4b3f96;background:#e6e2f5;padding:9px 16px;font-family:'Courier New',monospace;font-size:12px;font-weight:bold;color:#4b3f96;"><%= newRole %></td>
              </tr>
            </table>

            <table width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #d8dcd2;font-size:13px;">
              <tr>
                <td style="padding:9px 14px;color:#7b8177;">Branch</td>
                <td style="padding:9px 14px;text-align:right;color:#1a1d1a;"><%= branchName %></td>
              </tr>
            </table>

            <table width="100%" cellpadding="0" cellspacing="0" style="margin-top:18px;background:#f2ded9;border-left:3px solid #ad3a2d;">
              <tr>
                <td style="padding:14px 16px;font-size:13px;line-height:1.55;color:#8a2e24;">
                  <strong>Not expecting this?</strong> A role change affects what data you can reach. Contact your administrator before continuing.
                </td>
              </tr>
            </table>
          </td>
        </tr>
        <tr>
          <td style="padding:16px 28px;border-top:1px solid #d8dcd2;font-size:11px;color:#7b8177;">
            Automated message from the DMS Distributor Management System. Please do not reply.
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
