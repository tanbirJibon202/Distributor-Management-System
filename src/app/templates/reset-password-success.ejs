<table width="100%" cellpadding="0" cellspacing="0" style="background:#f4f5f3;padding:32px 12px;font-family:Helvetica,Arial,sans-serif;">
  <tr>
    <td align="center">
      <table width="100%" cellpadding="0" cellspacing="0" style="max-width:520px;background:#ffffff;border:1px solid #d8dcd2;">
        <tr>
          <td style="padding:24px 28px;border-bottom:3px solid #1a1d1a;">
            <div style="font-size:18px;font-weight:bold;color:#1a1d1a;">DMS Distributor</div>
            <div style="font-size:11px;letter-spacing:1.4px;text-transform:uppercase;color:#7b8177;margin-top:4px;">Password changed</div>
          </td>
        </tr>
        <tr>
          <td style="padding:28px;">
            <p style="margin:0 0 14px;font-size:15px;color:#1a1d1a;">Hello <%= name %>,</p>
            <p style="margin:0 0 18px;font-size:14px;line-height:1.55;color:#474d46;">
              Your DMS password was changed on <strong><%= changedAt %></strong>. You can sign in with it now.
            </p>
            <table width="100%" cellpadding="0" cellspacing="0" style="background:#f2ded9;border-left:3px solid #ad3a2d;">
              <tr>
                <td style="padding:14px 16px;font-size:13px;line-height:1.55;color:#8a2e24;">
                  <strong>Did not do this?</strong> Someone else may have access to your account. Reset your password again straight away and tell your administrator.
                </td>
              </tr>
            </table>
          </td>
        </tr>
        <tr>
          <td style="padding:16px 28px;border-top:1px solid #d8dcd2;font-size:11px;color:#7b8177;">
            Automated message from the DMS Distributor Management System. Please do not reply.
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
