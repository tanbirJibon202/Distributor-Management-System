<table width="100%" cellpadding="0" cellspacing="0" style="background:#f4f5f3;padding:32px 12px;font-family:Helvetica,Arial,sans-serif;">
  <tr>
    <td align="center">
      <table width="100%" cellpadding="0" cellspacing="0" style="max-width:520px;background:#ffffff;border:1px solid #d8dcd2;">
        <tr>
          <td style="padding:24px 28px;border-bottom:3px solid #1a1d1a;">
            <div style="font-size:18px;font-weight:bold;color:#1a1d1a;">DMS Distributor</div>
            <div style="font-size:11px;letter-spacing:1.4px;text-transform:uppercase;color:#7b8177;margin-top:4px;">Your account is active</div>
          </td>
        </tr>
        <tr>
          <td style="padding:28px;">
            <p style="margin:0 0 14px;font-size:15px;color:#1a1d1a;">Welcome, <%= name %>.</p>
            <p style="margin:0 0 20px;font-size:14px;line-height:1.55;color:#474d46;">
              Your email is verified and your staff account is now active. You can sign in with the password you chose during registration.
            </p>

            <table width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #d8dcd2;font-size:13px;">
              <tr>
                <td style="padding:9px 14px;color:#7b8177;border-bottom:1px solid #eceee8;">Sign in as</td>
                <td style="padding:9px 14px;text-align:right;font-family:'Courier New',monospace;color:#1a1d1a;border-bottom:1px solid #eceee8;"><%= email %></td>
              </tr>
              <tr>
                <td style="padding:9px 14px;color:#7b8177;border-bottom:1px solid #eceee8;">Role</td>
                <td style="padding:9px 14px;text-align:right;color:#1a1d1a;border-bottom:1px solid #eceee8;"><%= role %></td>
              </tr>
              <tr>
                <td style="padding:9px 14px;color:#7b8177;">Branch</td>
                <td style="padding:9px 14px;text-align:right;color:#1a1d1a;"><%= branchName %></td>
              </tr>
            </table>

            <p style="margin:20px 0 0;font-size:13px;line-height:1.55;color:#7b8177;">
              You did not request this account — it was created for you by <strong><%= authorizedBy %></strong>. If that is unexpected, tell your branch manager before signing in.
            </p>
          </td>
        </tr>
        <tr>
          <td style="padding:16px 28px;border-top:1px solid #d8dcd2;font-size:11px;color:#7b8177;">
            Automated message from the DMS Distributor Management System. Please do not reply.
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
