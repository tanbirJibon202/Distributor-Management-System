{
	"name": "dms-distributor-management-system",
	"version": "1.0.0",
	"description": "Cloud-based B2B distributor management system (DMS) backend - credit-based ordering, inventory, and bKash payments for FMCG/pharma distribution.",
	"main": "dist/src/server.js",
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"test": "node --import tsx --test tests/*.test.ts",
		"build": "prisma generate && tsc && node scripts/copy-templates.mjs",
		"start": "node dist/src/server.js",
		"postinstall": "prisma generate",
		"format:check": "npx @biomejs/biome format ./src",
		"format:fix": "npx @biomejs/biome format --write ./src",
		"lint:check": "npx @biomejs/biome lint ./src",
		"lint:fix": "npx @biomejs/biome lint --write ./src"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"engines": {
		"node": ">=20"
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.10.0",
		"@prisma/client": "^7.10.0",
		"bcryptjs": "^3.0.3",
		"cloudinary": "^2.11.0",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.6",
		"dotenv": "^16.4.7",
		"ejs": "^6.0.1",
		"express": "^5.1.0",
		"express-rate-limit": "^7.5.0",
		"google-auth-library": "^9.15.1",
		"helmet": "^8.0.0",
		"http-status": "^2.1.0",
		"jsonwebtoken": "^9.0.2",
		"multer": "^2.3.0",
		"node-cron": "^3.0.3",
		"nodemailer": "^10.0.0",
		"pdfkit": "^0.15.2",
		"pg": "^8.23.0",
		"rate-limit-redis": "^4.3.1",
		"redis": "^4.7.0",
		"zod": "^3.24.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@types/bcryptjs": "^2.4.6",
		"@types/cookie-parser": "^1.4.8",
		"@types/cors": "^2.8.17",
		"@types/ejs": "^3.1.5",
		"@types/express": "^5.0.0",
		"@types/jsonwebtoken": "^9.0.9",
		"@types/multer": "^2.2.0",
		"@types/node": "^22.13.5",
		"@types/node-cron": "^3.0.11",
		"@types/nodemailer": "^8.0.1",
		"@types/pdfkit": "^0.17.6",
		"@types/pg": "^8.23.1",
		"playwright": "^1.63.0",
		"prisma": "^7.10.0",
		"tsx": "^4.19.3",
		"typescript": "^5.7.3"
	},
	"allowScripts": {
		"@biomejs/biome@1.9.4": true,
		"@prisma/client@6.19.3": true,
		"@prisma/engines@6.19.3": true,
		"esbuild@0.28.2": true,
		"prisma@6.19.3": true
	}
}
