node_modules
dist
# Prisma 7 emits the client as TypeScript into the project rather than into
# node_modules. It is build output, regenerated by `postinstall` and by
# `npm run build`, so it is not committed.
src/generated
.env
# Anything derived from .env carries the same credentials: .env.local,
# .env.production, .env.backup-* and so on. The example file is the one
# deliberate exception, since it holds placeholders only.
.env.*
!.env.example
*.log
.DS_Store
