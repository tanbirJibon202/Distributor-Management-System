# App
NODE_ENV=development
PORT=5000

# Database
# DATABASE_URL is what the running app uses. On a pooled provider such as Neon
# this is the pooled endpoint (the host containing `-pooler`).
DATABASE_URL="postgresql://YOUR_USERNAME:YOUR_PASSWORD@localhost:5432/dms?schema=public"
# DIRECT_URL is used only by `prisma migrate` — migrations take an advisory
# lock and run DDL, which a transaction pooler breaks. Same database, direct
# endpoint (drop `-pooler` from the host). On a plain Postgres with no pooler,
# set it to the same value as DATABASE_URL.
DIRECT_URL="postgresql://YOUR_USERNAME:YOUR_PASSWORD@localhost:5432/dms?schema=public"

# JWT
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id

# Redis
REDIS_URL=redis://localhost:6379

# bKash sandbox
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_USERNAME=your-bkash-username
BKASH_PASSWORD=your-bkash-password
BKASH_APP_KEY=your-bkash-app-key
BKASH_APP_SECRET=your-bkash-app-secret
BKASH_CALLBACK_URL=http://localhost:5000/api/v1/payments/callback

# Seed — demo credentials
# Email — required for registration OTP, password reset and invoice email.
# Without these those routes return 503 and the rest of the API works.
# For Gmail, SMTP_PASSWORD must be a 16-character App Password, not the
# account password, and the account needs 2-step verification enabled.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_SENDER="DMS Distributor <your-email@gmail.com>"

# Cloudinary — required only for the image upload routes; 503 without it.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=admin@dms.com
SUPER_ADMIN_PASSWORD=SuperAdmin123!
