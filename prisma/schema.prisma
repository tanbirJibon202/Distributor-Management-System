generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  BRANCH_MANAGER
  FIELD_SR
}

enum OrderStatus {
  PENDING
  APPROVED
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  FAILED
}

enum PaymentMethod {
  BKASH
  BANK_TRANSFER
}

// ─── Models ─────────────────────────────────────────────────────────────

// Soft-deleted rows keep their unique value but get `:deleted:<id>` appended
// to email/sku/phone, so a fresh row can reuse the original value without
// tripping the unique constraint. Always read/write the clean value through
// the service layer; never expose the mutated value to a client.

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String? // nullable — Google-authenticated users have no password
  phone     String?
  role      Role      @default(FIELD_SR)
  branchId  String?
  googleId  String?   @unique
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  branch    Branch?    @relation(fields: [branchId], references: [id])
  orders    Order[]    @relation("SROrders")
  auditLogs AuditLog[]

  @@index([email, role])
  @@index([branchId, role])
  @@map("users")
}

model Branch {
  id        String    @id @default(uuid())
  name      String
  code      String    @unique
  type      String // CENTRAL | DEPOT | BRANCH
  location  String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  users       User[]
  inventories BranchInventory[]
  orders      Order[]

  @@map("branches")
}

model Product {
  id        String    @id @default(uuid())
  name      String
  sku       String    @unique
  description String?
  category  String
  unit      String // PCS | CTN | KG
  price     Decimal   @db.Decimal(12, 2)
  costPrice Decimal   @db.Decimal(12, 2)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  inventories BranchInventory[]
  orderItems  OrderItem[]

  @@index([category])
  @@index([name])
  @@map("products")
}

model BranchInventory {
  id        String   @id @default(uuid())
  branchId  String
  productId String
  stock     Int      @default(0)
  updatedAt DateTime @updatedAt

  branch  Branch  @relation(fields: [branchId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([branchId, productId])
  @@map("branch_inventories")
}

model Retailer {
  id          String    @id @default(uuid())
  shopName    String
  ownerName   String
  phone       String    @unique
  address     String
  routeArea   String
  creditLimit Decimal   @default(50000) @db.Decimal(12, 2)
  dueBalance  Decimal   @default(0) @db.Decimal(12, 2)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  orders Order[]

  @@index([routeArea])
  @@map("retailers")
}

model Order {
  id             String        @id @default(uuid())
  invoiceNo      String        @unique
  branchId       String
  srId           String
  retailerId     String
  totalAmount    Decimal       @db.Decimal(12, 2)
  discount       Decimal       @default(0) @db.Decimal(12, 2)
  payableAmount  Decimal       @db.Decimal(12, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(12, 2)
  dueDate        DateTime
  status         OrderStatus   @default(PENDING)
  paymentStatus  PaymentStatus @default(UNPAID)
  paymentMethod  PaymentMethod?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  branch   Branch      @relation(fields: [branchId], references: [id])
  sr       User        @relation("SROrders", fields: [srId], references: [id])
  retailer Retailer    @relation(fields: [retailerId], references: [id])
  items    OrderItem[]
  payments Payment[]

  @@index([branchId, status])
  @@index([srId, createdAt])
  @@index([retailerId])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  subTotal  Decimal @db.Decimal(12, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id               String        @id @default(uuid())
  orderId          String
  transactionId    String?       @unique
  gatewayPaymentId String?
  amount           Decimal       @db.Decimal(12, 2)
  provider         PaymentMethod
  status           PaymentStatus @default(UNPAID)
  createdAt        DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("payments")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  entity    String
  entityId  String
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("audit_logs")
}
