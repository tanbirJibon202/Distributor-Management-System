model Product {
  id          String    @id @default(uuid())
  name        String
  sku         String    @unique
  description String?
  category    String
  unit        String // PCS | CTN | KG
  price       Decimal   @db.Decimal(12, 2)
  costPrice   Decimal   @db.Decimal(12, 2)
  // Cloudinary's secure URL, plus the public id needed to delete the old file
  // when the image is replaced. Both null until an image is uploaded.
  imageUrl      String?
  imagePublicId String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  inventories BranchInventory[]
  orderItems  OrderItem[]

  @@index([category])
  @@index([name])
  @@map("products")
}

model BranchInventory {
  id        String   @id @default(uuid())
  branchId  String
  productId String
  stock     Int      @default(0)
  updatedAt DateTime @updatedAt

  branch  Branch  @relation(fields: [branchId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([branchId, productId])
  @@map("branch_inventories")
}
