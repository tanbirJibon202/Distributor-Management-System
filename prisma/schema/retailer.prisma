model Retailer {
  id          String    @id @default(uuid())
  shopName    String
  ownerName   String
  phone       String    @unique
  // Optional, and deliberately not unique: a shopkeeper may have no email at
  // all, and a family running two shops may well share one. Phone stays the
  // identifying key. Only used to send invoice copies.
  email       String?
  address     String
  routeArea   String
  creditLimit Decimal   @default(50000) @db.Decimal(12, 2)
  dueBalance  Decimal   @default(0) @db.Decimal(12, 2)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  orders Order[]

  @@index([routeArea])
  @@map("retailers")
}
