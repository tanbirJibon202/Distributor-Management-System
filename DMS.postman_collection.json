{
  "info": {
    "name": "DMS - Distributor Management System",
    "description": "B2B distribution backend: credit-based ordering, branch inventory, and bKash payments.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api/v1" },
    { "key": "accessToken", "value": "" },
    { "key": "branchId", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "retailerId", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "userId", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register (Field SR)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"SR Demo\",\n  \"email\": \"sr.demo@dms.com\",\n  \"password\": \"password123\",\n  \"phone\": \"01710000099\",\n  \"branchId\": \"{{branchId}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@dms.com\",\n  \"password\": \"SuperAdmin123!\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{baseUrl}}/auth/refresh-token",
            "description": "Reads the refreshToken httpOnly cookie set by login/register."
          }
        },
        {
          "name": "Google Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"idToken\": \"<google-id-token>\"\n}" },
            "url": "{{baseUrl}}/auth/google"
          }
        },
        {
          "name": "Get Me",
          "request": { "method": "GET", "url": "{{baseUrl}}/auth/me" }
        }
      ]
    },
    {
      "name": "User",
      "item": [
        {
          "name": "Update My Profile",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Updated Name\",\n  \"phone\": \"01711111111\"\n}" },
            "url": "{{baseUrl}}/users/me"
          }
        },
        {
          "name": "Admin: Change User Role",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"BRANCH_MANAGER\",\n  \"branchId\": \"{{branchId}}\"\n}"
            },
            "url": "{{baseUrl}}/admin/users/{{userId}}/role"
          }
        }
      ]
    },
    {
      "name": "Branch",
      "item": [
        {
          "name": "Create Branch (SUPER_ADMIN)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sylhet Branch\",\n  \"code\": \"SYL-01\",\n  \"type\": \"BRANCH\",\n  \"location\": \"Sylhet\"\n}"
            },
            "url": "{{baseUrl}}/branches"
          }
        },
        {
          "name": "List Branches",
          "request": { "method": "GET", "url": "{{baseUrl}}/branches" }
        }
      ]
    },
    {
      "name": "Product",
      "item": [
        {
          "name": "Create Product (SUPER_ADMIN)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sample Product\",\n  \"sku\": \"SKU-100\",\n  \"category\": \"Grocery\",\n  \"unit\": \"PCS\",\n  \"price\": 100,\n  \"costPrice\": 80\n}"
            },
            "url": "{{baseUrl}}/products"
          }
        },
        {
          "name": "List Products (search/filter/sort/paginate)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products?page=1&limit=10&search=soap&category=Toiletries&sortBy=price&sortOrder=asc",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "search", "value": "soap" },
                { "key": "category", "value": "Toiletries" },
                { "key": "sortBy", "value": "price" },
                { "key": "sortOrder", "value": "asc" }
              ]
            }
          }
        },
        {
          "name": "Get Product By Id",
          "request": { "method": "GET", "url": "{{baseUrl}}/products/{{productId}}" }
        },
        {
          "name": "Delete Product (SUPER_ADMIN)",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/products/{{productId}}" }
        }
      ]
    },
    {
      "name": "Inventory",
      "item": [
        {
          "name": "Adjust Inventory",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"branchId\": \"{{branchId}}\",\n  \"quantity\": 50,\n  \"reason\": \"Stock replenishment\"\n}"
            },
            "url": "{{baseUrl}}/inventory/adjust"
          }
        }
      ]
    },
    {
      "name": "Retailer",
      "item": [
        {
          "name": "Create Retailer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shopName\": \"New Shop\",\n  \"ownerName\": \"Shop Owner\",\n  \"phone\": \"01799999999\",\n  \"address\": \"Dhaka\",\n  \"routeArea\": \"Mirpur\",\n  \"creditLimit\": 50000\n}"
            },
            "url": "{{baseUrl}}/retailers"
          }
        },
        {
          "name": "Get Retailer Credit Status",
          "request": { "method": "GET", "url": "{{baseUrl}}/retailers/{{retailerId}}/credit-status" }
        }
      ]
    },
    {
      "name": "Order",
      "item": [
        {
          "name": "Create Order (FIELD_SR)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"retailerId\": \"{{retailerId}}\",\n  \"items\": [\n    { \"productId\": \"{{productId}}\", \"quantity\": 5 }\n  ],\n  \"discount\": 0\n}"
            },
            "url": "{{baseUrl}}/orders"
          }
        },
        {
          "name": "List Orders (role-scoped)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/orders?page=1&limit=10&status=PENDING",
              "host": ["{{baseUrl}}"],
              "path": ["orders"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "status", "value": "PENDING" }
              ]
            }
          }
        },
        {
          "name": "Update Order Status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"APPROVED\"\n}" },
            "url": "{{baseUrl}}/orders/{{orderId}}/status"
          }
        }
      ]
    },
    {
      "name": "Payment",
      "item": [
        {
          "name": "Initiate Payment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"orderId\": \"{{orderId}}\"\n}" },
            "url": "{{baseUrl}}/payments/initiate"
          }
        },
        {
          "name": "Payment Callback (bKash redirect)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/payments/callback?paymentID=<paymentID>&status=success",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "callback"],
              "query": [
                { "key": "paymentID", "value": "<paymentID>" },
                { "key": "status", "value": "success" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Audit Logs (SUPER_ADMIN)",
          "request": { "method": "GET", "url": "{{baseUrl}}/admin/audit-logs?page=1&limit=20" }
        }
      ]
    }
  ]
}
