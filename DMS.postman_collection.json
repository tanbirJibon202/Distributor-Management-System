{
  "info": {
    "name": "DMS - Distributor Management System",
    "description": "B2B distribution backend: credit-based ordering, branch inventory, and bKash payments.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "branchId",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "retailerId",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "paymentId",
      "value": ""
    },
    {
      "key": "otp",
      "value": ""
    },
    {
      "key": "pendingEmail",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register (step 1 of 2 — sends OTP)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"SR Demo\",\n  \"email\": \"sr.demo@dms.com\",\n  \"password\": \"password123\",\n  \"phone\": \"01710000099\",\n  \"branchId\": \"{{branchId}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/register",
            "description": "Requires a SUPER_ADMIN or own-branch BRANCH_MANAGER access token. Stages an approved FIELD_SR account; the employee activates it with the emailed OTP.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Verify Email (step 2 of 2 — creates account)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sr.demo@dms.com\",\n  \"otp\": \"{{otp}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/verify-email",
            "description": "Consumes the code, creates the user and returns tokens. Codes are single use, expire in 5 minutes, and allow 5 attempts before being invalidated."
          }
        },
        {
          "name": "Resend Registration OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sr.demo@dms.com\"\n}"
            },
            "url": "{{baseUrl}}/auth/resend-otp",
            "description": "Issues a fresh code for a registration still staged in Redis."
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"manager.dhaka@dms.com\",\n  \"password\": \"Manager123!\"\n}"
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Copy accessToken from the response into the collection variable. The super admin address is whatever SUPER_ADMIN_EMAIL is set to, so this uses a seeded demo account instead."
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"manager.dhaka@dms.com\"\n}"
            },
            "url": "{{baseUrl}}/auth/forgot-password",
            "description": "Always answers the same whether or not the account exists, so the endpoint cannot be used to discover which emails are registered. Google-only accounts are silently skipped."
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"manager.dhaka@dms.com\",\n  \"otp\": \"{{otp}}\",\n  \"newPassword\": \"NewPassword123!\"\n}"
            },
            "url": "{{baseUrl}}/auth/reset-password",
            "description": "Verifies the emailed code and sets the new password. 5 attempts, then the code is burned."
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": "{{baseUrl}}/auth/refresh-token",
            "description": "Reads the refreshToken httpOnly cookie set by login/register."
          }
        },
        {
          "name": "Google Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idToken\": \"<google-id-token>\"\n}"
            },
            "url": "{{baseUrl}}/auth/google",
            "description": "Google sign-in for an existing approved staff account only. Google email must be verified; unknown accounts are rejected."
          }
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/logout",
            "description": "Requires a valid access token. Revokes all access and refresh sessions for this staff account.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "User",
      "item": [
        {
          "name": "Update My Profile",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Name\",\n  \"phone\": \"01711111111\"\n}"
            },
            "url": "{{baseUrl}}/users/me"
          }
        },
        {
          "name": "Update My Profile Image",
          "request": {
            "method": "PATCH",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": "{{baseUrl}}/users/me/image",
            "description": "multipart/form-data with a single \"image\" field. JPEG, PNG or WebP, max 5MB. Any authenticated role may set their own. Requires the CLOUDINARY_* variables; returns 503 without them."
          }
        },
        {
          "name": "Admin: Change User Role",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"BRANCH_MANAGER\",\n  \"branchId\": \"{{branchId}}\"\n}"
            },
            "url": "{{baseUrl}}/admin/users/{{userId}}/role"
          }
        },
        {
          "name": "Admin: Deactivate User",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/admin/users/{{userId}}",
            "description": "Soft delete. Refuses to deactivate your own account or the last remaining super admin. Rewrites email/googleId to <value>:deleted:<id> so the address can be reused."
          }
        },
        {
          "name": "Admin: List Users (filter + paginate)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/admin/users?page=1&limit=10&role=FIELD_SR&search=sr",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "users"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "role",
                  "value": "FIELD_SR"
                },
                {
                  "key": "search",
                  "value": "sr"
                }
              ]
            },
            "description": "SUPER_ADMIN only."
          }
        }
      ]
    },
    {
      "name": "Branch",
      "item": [
        {
          "name": "Create Branch (SUPER_ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sylhet Branch\",\n  \"code\": \"SYL-01\",\n  \"type\": \"BRANCH\",\n  \"location\": \"Sylhet\"\n}"
            },
            "url": "{{baseUrl}}/branches"
          }
        },
        {
          "name": "List Branches",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/branches"
          }
        }
      ]
    },
    {
      "name": "Product",
      "item": [
        {
          "name": "Create Product (SUPER_ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sample Product\",\n  \"sku\": \"SKU-100\",\n  \"category\": \"Grocery\",\n  \"unit\": \"PCS\",\n  \"price\": 100,\n  \"costPrice\": 80\n}"
            },
            "url": "{{baseUrl}}/products"
          }
        },
        {
          "name": "List Products (search/filter/sort/paginate)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products?page=1&limit=10&search=soap&category=Toiletries&sortBy=price&sortOrder=asc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "search",
                  "value": "soap"
                },
                {
                  "key": "category",
                  "value": "Toiletries"
                },
                {
                  "key": "sortBy",
                  "value": "price"
                },
                {
                  "key": "sortOrder",
                  "value": "asc"
                }
              ]
            }
          }
        },
        {
          "name": "Get Product By Id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products/{{productId}}"
          }
        },
        {
          "name": "Delete Product (SUPER_ADMIN)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/products/{{productId}}"
          }
        },
        {
          "name": "Update Product (SUPER_ADMIN)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 120,\n  \"category\": \"Grocery\"\n}"
            },
            "url": "{{baseUrl}}/products/{{productId}}"
          }
        },
        {
          "name": "Update Product Image (SUPER_ADMIN)",
          "request": {
            "method": "PATCH",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": "{{baseUrl}}/products/{{productId}}/image",
            "description": "multipart/form-data with a single \"image\" field. JPEG, PNG or WebP, max 5MB. Requires the CLOUDINARY_* variables; returns 503 without them."
          }
        }
      ]
    },
    {
      "name": "Inventory",
      "item": [
        {
          "name": "Adjust Inventory",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"branchId\": \"{{branchId}}\",\n  \"quantity\": 50,\n  \"reason\": \"Stock replenishment\"\n}"
            },
            "url": "{{baseUrl}}/inventory/adjust"
          }
        },
        {
          "name": "List Inventory (branch-scoped)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/inventory?page=1&limit=10&lowStock=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "inventory"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "lowStock",
                  "value": "50"
                }
              ]
            },
            "description": "A manager/SR sees only their own branch; SUPER_ADMIN sees all and may pass ?branchId=."
          }
        }
      ]
    },
    {
      "name": "Retailer",
      "item": [
        {
          "name": "Create Retailer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shopName\": \"New Shop\",\n  \"ownerName\": \"Shop Owner\",\n  \"phone\": \"01799999999\",\n  \"address\": \"Dhaka\",\n  \"routeArea\": \"Mirpur\",\n  \"creditLimit\": 50000\n}"
            },
            "url": "{{baseUrl}}/retailers"
          }
        },
        {
          "name": "Get Retailer Credit Status",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/retailers/{{retailerId}}/credit-status"
          }
        },
        {
          "name": "List Retailers (search + paginate)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/retailers?page=1&limit=10&search=karim&routeArea=Mirpur",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "retailers"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "search",
                  "value": "karim"
                },
                {
                  "key": "routeArea",
                  "value": "Mirpur"
                }
              ]
            }
          }
        },
        {
          "name": "Delete Retailer (soft delete)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/retailers/{{retailerId}}",
            "description": "Refused while the retailer still owes money."
          }
        }
      ]
    },
    {
      "name": "Order",
      "item": [
        {
          "name": "Create Order (FIELD_SR)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"retailerId\": \"{{retailerId}}\",\n  \"items\": [\n    { \"productId\": \"{{productId}}\", \"quantity\": 5 }\n  ],\n  \"discount\": 0\n}"
            },
            "url": "{{baseUrl}}/orders"
          }
        },
        {
          "name": "List Orders (role-scoped)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/orders?page=1&limit=10&status=PENDING",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "status",
                  "value": "PENDING"
                }
              ]
            }
          }
        },
        {
          "name": "Update Order Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"APPROVED\"\n}"
            },
            "url": "{{baseUrl}}/orders/{{orderId}}/status"
          }
        },
        {
          "name": "Get Order By Id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/orders/{{orderId}}",
            "description": "Role-scoped: an SR reading another SR’s order gets 403."
          }
        },
        {
          "name": "Download Invoice PDF",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/orders/{{orderId}}/invoice",
            "description": "Responds with application/pdf rather than the usual JSON envelope. Role-scoped exactly like Get Order By Id."
          }
        },
        {
          "name": "Email Invoice to Retailer",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/orders/{{orderId}}/invoice/email",
            "description": "Sends the same PDF as an attachment to retailers.email. Returns 400 if that retailer has no email on file, and 503 if SMTP is not configured."
          }
        }
      ]
    },
    {
      "name": "Payment",
      "item": [
        {
          "name": "Initiate Payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{orderId}}\"\n}"
            },
            "url": "{{baseUrl}}/payments/initiate"
          }
        },
        {
          "name": "Payment Callback (bKash redirect)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/payments/callback?paymentID=<paymentID>&status=success",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "callback"
              ],
              "query": [
                {
                  "key": "paymentID",
                  "value": "<paymentID>"
                },
                {
                  "key": "status",
                  "value": "success"
                }
              ]
            }
          }
        },
        {
          "name": "Payment Callback (bKash redirect) (GET redirect)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/payments/callback?paymentID=<paymentID>&status=success",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "callback"
              ],
              "query": [
                {
                  "key": "paymentID",
                  "value": "<paymentID>"
                },
                {
                  "key": "status",
                  "value": "success"
                }
              ]
            }
          }
        },
        {
          "name": "Get Payment Status",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/payments/{{paymentId}}"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Audit Logs (SUPER_ADMIN)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/audit-logs?page=1&limit=20"
          }
        },
        {
          "name": "Dashboard Stats (SUPER_ADMIN)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/dashboard-stats"
          }
        }
      ]
    }
  ]
}
